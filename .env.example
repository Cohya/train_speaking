# Copy to .env and adjust. All settings use the TS_ prefix; environment variables override .env.
# Never commit a .env containing API keys.

# --- Server ---
# TS_HOST=127.0.0.1
# TS_PORT=8080
# TS_OPEN_BROWSER=true

# --- Speech (local) ---
# TS_STT_PROVIDER=faster_whisper        # or: fake (tests/demo only)
# TS_STT_MODEL=large-v3-turbo
# TS_STT_CPU_FALLBACK_MODEL=small.en
# TS_STT_DEVICE=auto                    # auto | cuda | cpu
# TS_TTS_PROVIDER=kokoro                # or: none (questions shown as text only)
# TS_TTS_VOICE=af_heart
# TS_TTS_SPEED=1.0
# TS_VAD_PROVIDER=silero                # or: energy

# --- LLM interviewer and evaluator (optional) ---
# Without an LLM, the built-in question bank is used and only measured categories are scored.
#
# Local Ollama (install Ollama yourself, then: ollama pull qwen2.5:14b):
# TS_LLM_PROVIDER=openai_compatible
# TS_LLM_BASE_URL=http://localhost:11434/v1
# TS_LLM_MODEL=qwen2.5:14b
#
# Cloud provider with an OpenAI-compatible API (transcripts are sent to the provider;
# the setup page then asks for explicit consent):
# TS_LLM_PROVIDER=openai_compatible
# TS_LLM_BASE_URL=https://api.openai.com/v1
# TS_LLM_MODEL=<model name>
# TS_LLM_API_KEY=<your key>
# TS_LLM_IS_CLOUD=true
# Prices from your provider, used only for the on-screen cost estimate:
# TS_COST_PER_1K_INPUT_TOKENS=0.0
# TS_COST_PER_1K_OUTPUT_TOKENS=0.0
#
# Optional separate evaluator model (unset values reuse the interviewer settings):
# TS_EVAL_LLM_BASE_URL=
# TS_EVAL_LLM_MODEL=
# TS_EVAL_LLM_API_KEY=
#
# TS_LLM_TIMEOUT_S=30
# TS_MAX_TOKENS_PER_CALL=800
# TS_SESSION_TOKEN_BUDGET=80000

# --- Features ---
# TS_INTERIM_TRANSCRIPTS=false          # live partial transcript while you speak (extra GPU load)
# TS_AVATAR_MODE=amplitude              # or: viseme (lip shapes from TTS phoneme timings)

# --- Storage and logging ---
# TS_DATA_DIR=./data
# TS_MODELS_DIR=./models
# TS_LOG_LEVEL=INFO
# TS_LOG_TRANSCRIPTS=false              # transcripts are personal data; keep off unless debugging
